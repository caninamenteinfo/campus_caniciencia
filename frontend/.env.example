# Mismos valores públicos que backend/.env (Supabase Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# URL del backend Express
VITE_API_URL=http://localhost:5000

# Clave pública VAPID (la misma que backend/.env VAPID_PUBLIC_KEY) para
# activar notificaciones push en el navegador.
VITE_VAPID_PUBLIC_KEY=
