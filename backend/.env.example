# === Servidor ===
PORT=5000
FRONTEND_URL=http://localhost:3000

# === Supabase (Project Settings → API) ===
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave anónima (pública, la usa el frontend)
SUPABASE_ANON_KEY=eyJ...
# Clave service_role — NUNCA exponer al navegador, solo en el backend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Anthropic (Claude) — console.anthropic.com ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# === Google Drive / Calendar ===
# La app usa el provider_token de Google que Supabase Auth entrega al hacer
# login (scopes de Drive/Calendar pedidos en el frontend). No hace falta
# credenciales propias salvo que quieras leer documentos sin sesión de
# usuario activa (service account), en cuyo caso completa esto:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Documento MAESTRO de estrategia (Google Doc)
MASTER_DOC_FILE_ID=1JUaYAnO-D6ET5Hcf0vKEvPP2wgkHTKy7g3RpQ1-4ev4

# === Canva Connect API (canva.com/developers) ===
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:5000/api/canva/oauth/callback
# Brand template por defecto/fallback si la categoría no matchea ninguna de abajo
CANVA_BRAND_TEMPLATE_ID=

# Mapeo categoría de reel → brand template de Canva (los 5 de la Guía de
# Diseño). Completá los que tengas creados — el resto cae al default de
# arriba.
CANVA_TEMPLATE_NEUROBIOLOGIA=
CANVA_TEMPLATE_TRANSFORMACIONAL=
CANVA_TEMPLATE_DESMITIFICACION=
CANVA_TEMPLATE_CARRUSEL=
CANVA_TEMPLATE_EVENTO=

# === Almacenamiento de los MP4 exportados ===
# Por defecto se guardan en disco local (server efímero, sirve para
# desarrollo/una sola instancia). Para producción, configurá un bucket de
# Google Cloud Storage (reutiliza GOOGLE_SERVICE_ACCOUNT_* de arriba — dale
# rol "Storage Object Admin" sobre el bucket).
MEDIA_STORAGE_DIR=/tmp/caninamente-media
GCS_BUCKET=
GCS_PREFIX=reels/
GOOGLE_PROJECT_ID=

# === Notificaciones push (alarmas del flujo semanal) ===
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:caninamente.info@gmail.com

# Secreto para encriptar tokens de integraciones guardados en DB
TOKEN_ENCRYPTION_KEY=cambia-esto-por-una-cadena-aleatoria-de-32-bytes
