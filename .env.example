# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Nunca exponer al navegador: solo se usa en código de servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: sobrescribe el modelo por defecto (claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Secreto para firmar la cookie de sesión de alumno (mínimo 32 caracteres aleatorios)
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-y-secreta
